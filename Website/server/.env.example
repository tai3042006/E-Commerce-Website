# Copy this file to .env and fill in your MySQL credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=clofit

# Port the Express API listens on
PORT=4000

# If set, the server auto-creates the `clofit` database if it does not exist
# (requires DB_USER to have CREATE DATABASE privilege)
AUTO_CREATE_DB=true
